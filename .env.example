# Career OS 환경변수 예시 — 실제 값은 .env (로컬) 와 Vercel 환경변수에 넣습니다.
# 사용법: cp .env.example .env  후 값을 채우세요.

# ── 클라이언트 (Vite가 빌드 타임에 번들로 인라인함) ──────────────
# Supabase Dashboard → Project Settings → API
# anon / public 키만 사용. service_role 키는 절대 사용 금지.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── 서버 (/api/* 서버리스 함수 전용, 브라우저에 노출되지 않음) ────
# 셋 중 최소 하나 필요. 시도 순서: Anthropic → OpenAI → Gemini
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# ── Supabase CLI (로컬 마이그레이션 작업용) ─────────────────────
# 앱 코드는 이 값을 읽지 않습니다. supabase CLI 가 셸 환경변수에서 읽습니다.
# 발급: https://supabase.com/dashboard/account/tokens
# 주의: CLI 는 .env 를 자동으로 읽지 않습니다. 셸에 export 하거나
#      `npx supabase login` 으로 대신 인증하세요.
#      export SUPABASE_ACCESS_TOKEN=sbp_...
SUPABASE_ACCESS_TOKEN=
